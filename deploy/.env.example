# Copy to deploy/.env (gitignored) and fill in. This file is the host secret mechanism for the
# compose MVP (Ch. 48): values reach containers as env or as /run/secrets files, never images.
# Generate every password/token with:  openssl rand -hex 32   (hex keeps URLs valid)

# Image to run (built with `docker build -t keystone:dev .`; pin a signed digest in production)
KEYSTONE_IMAGE=keystone:dev

# Required service settings (Ch. 47)
KEYSTONE_AWS_REGION=eu-west-1
KEYSTONE_OIDC_AUDIENCE=https://github.com/your-org
KEYSTONE_ANCHOR_BUCKET=your-anchor-bucket          # S3 Object Lock (COMPLIANCE) bucket, A8
# KEYSTONE_TRUSTED_PROXIES=10.0.0.0/24             # your load balancers' CIDRs, if any
# PUBLIC_BIND=127.0.0.1                            # where the public plane is published

# Secrets
PG_OWNER_PASSWORD=                                 # schema owner; used only by `provision`
APP_DB_PASSWORD=                                   # the services' least-privilege login
REDIS_PASSWORD=
KEYSTONE_BUNDLE_SERVICE_TOKEN=                     # OPA's bearer for the bundle route (>= 32)
KEYSTONE_ADMIN_BOOTSTRAP_TOKEN=                    # first admin login; remove after first use

# Key files (paths on the host)
ANCHOR_SIGNING_KEY_FILE=./secrets/anchor_ed25519.pem        # Ed25519 private key (A8)
OPA_BUNDLE_PUBLIC_KEY_FILE=./secrets/bundle_signing_pub.pem # RSA public half of the CI key
